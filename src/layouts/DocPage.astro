---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout, { type LayoutProps } from "./Layout.astro";

type Props = {
	entry: CollectionEntry<"docs">;
};

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const layout: LayoutProps = {
	title: entry.data.title,
	description: entry.data.description,
};

type TocItem = { label: string; slug: string };

const tocItems: TocItem[] = entry.data.toc?.length
	? entry.data.toc.map((item) => ({
			label: item.label,
			slug: item.anchor,
		}))
	: headings
			.filter((h) => h.depth === 2)
			.slice(0, 5)
			.map((h) => ({ label: h.text, slug: h.slug }));
---

<Layout layout={layout}>
	<article class="doc-page container">
		<header class="doc-header">
			<h1>{entry.data.title}</h1>
			{
				entry.data.subtitle && (
					<p class="doc-subtitle">{entry.data.subtitle}</p>
				)
			}
			{
				tocItems.length > 0 && (
					<nav class="doc-toc" aria-label="Page sections">
						<ul class="doc-toc-list">
							{tocItems.map((item) => (
								<li class="doc-toc-item">
									<a href={`#${item.slug}`}>{item.label}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</header>

		<div class="doc-content">
			<Content />
		</div>
	</article>
</Layout>

<script>
	import { initMermaidDiagrams } from "../scripts/mermaid-init";

	initMermaidDiagrams();
</script>

<style>
	.doc-page {
		margin-bottom: 2rem;
	}

	.doc-header {
		margin-bottom: 1.5rem;
		padding-bottom: 0;
	}

	.doc-subtitle {
		color: var(--ab-comment-color);
		font-size: 1.05em;
		margin-top: 0.5rem;
		margin-bottom: 0;
	}

	.doc-toc {
		margin-top: 1rem;
		padding: 0;
		border: none;
		background: transparent;
	}

	.doc-toc-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.doc-toc-item {
		margin: 0;
	}

	.doc-toc-item a {
		display: inline-block;
		font-size: 0.85em;
		padding: 0.25em 0.65em;
		border-radius: 0.25rem;
		border: 1px solid var(--ab-glass-border);
		background-color: var(--ab-glass);
		background-image: none;
		color: var(--pico-color);
		-webkit-text-fill-color: currentColor;
		background-clip: border-box;
		-webkit-background-clip: border-box;
		text-decoration: none;
		line-height: 1.4;
		font-weight: 500;
	}

	.doc-toc-item a:hover {
		color: var(--pico-primary);
		border-color: var(--pico-primary);
		font-weight: 600;
	}

	.doc-content {
		margin-top: 0.5rem;
	}

	.doc-content :global(h2),
	.doc-content :global(h3) {
		scroll-margin-top: 1rem;
	}

	.doc-content :global(pre) {
		overflow-x: auto;
	}

	.doc-content :global(.mermaid) {
		margin: 1.5rem 0;
		text-align: center;
		overflow-x: auto;
	}

	.doc-content :global(.mermaid svg) {
		max-width: 100%;
		height: auto;
	}
</style>
