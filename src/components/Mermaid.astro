---
/**
 * Client-side Mermaid for ```mermaid fences (docs) and
 * <pre data-language="mermaid"> blocks in Astro components.
 */
---

<script>
  async function renderMermaid() {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (!blocks.length) return;

    const { default: mermaid } =
      await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");

    const theme =
      document.documentElement.getAttribute("data-theme") === "light"
        ? "neutral"
        : "dark";

    mermaid.initialize({
      startOnLoad: false,
      theme,
      securityLevel: "strict",
      flowchart: { curve: "basis", htmlLabels: true },
    });

    let i = 0;
    for (const pre of blocks) {
      const source = (pre.textContent ?? "").trim();
      if (!source) continue;

      const host = document.createElement("div");
      host.className = "mermaid-diagram";
      host.setAttribute("role", "img");

      try {
        const id = `mermaid-${i++}`;
        const { svg } = await mermaid.render(id, source);
        host.innerHTML = svg;
        pre.replaceWith(host);
      } catch (err) {
        console.error("Mermaid render failed:", err);
      }
    }
  }

  renderMermaid();
</script>

<style is:global>
  pre[data-language="mermaid"] {
    visibility: hidden;
    min-height: 6rem;
  }

  .mermaid-diagram {
    margin: 1.25rem 0;
    padding: 0.75rem 0.5rem;
    overflow-x: auto;
    text-align: center;
    background: color-mix(in srgb, var(--ab-glass) 80%, transparent);
    border: 1px solid var(--ab-glass-border);
    border-radius: 0.35rem;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }
</style>
