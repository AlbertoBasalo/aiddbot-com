---
import BlinkCursor from "./BlinkCursor.astro";

const ROWS: { when: string; youCheck: string }[] = [
  {
    when: "After exploration",
    youCheck: "Architecture, schemas, and coding rules match the repo",
  },
  {
    when: "After specification",
    youCheck: "Problem, outcomes, and acceptance criteria are right",
  },
  {
    when: "After drift detection",
    youCheck: "The top defect is picked and the spec is refactored",
  },
];

const FLOW = `flowchart LR
  E[explore ] -->|you ✔️| S[specify]
  S -->|you ✔️| B[release]
  B -->|you ✔️| R[refactor]
  `;
---

<section class="container">
  <header>
    <h2>Human checkpoints</h2>
    <span>
      You only review twice. Everything else runs without asking.
      <BlinkCursor />
    </span>
  </header>

  <div class="skills-table-wrap">
    <table class="skills-table">
      <thead>
        <tr>
          <th scope="col">Trigger</th>
          <th scope="col">You check</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) => (
            <tr>
              <th scope="row">{row.when}</th>
              <td>{row.youCheck}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <pre data-language="mermaid">{FLOW}</pre>
</section>

<style>
  .skills-table-wrap {
    overflow-x: auto;
    margin: 0;
    padding: 0;
    background: transparent !important;
    border: none;
    backdrop-filter: none;
  }

  .skills-table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.92em;
  }

  .skills-table th,
  .skills-table td {
    padding: 0.65rem 0.85rem;
    vertical-align: top;
    border-bottom: 1px solid var(--ab-glass-border);
  }

  .skills-table thead th {
    font-family: var(--pico-font-family-sans-serif);
    font-weight: 500;
    font-size: 0.85em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ab-comment-color);
    border-bottom-width: 2px;
  }

  .skills-table tbody th[scope="row"] {
    font-weight: 500;
    white-space: nowrap;
  }
</style>
