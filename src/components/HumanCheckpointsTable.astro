---
import BlinkCursor from "./BlinkCursor.astro";

const ROWS: { step: string; youReview: string }[] = [
  { step: "/establish", youReview: "Project context and instructions" },
  { step: "/explore", youReview: "Architecture and codebase" },
  { step: "/excavate", youReview: "Tier/component architecture and ER model" },
  { step: "/extract", youReview: "Rules and conventions" },
  { step: "/specify", youReview: "Problem, solution, and acceptance criteria" },
  { step: "/planify", youReview: "Implementation steps for each tier" },
  { step: "/codify", youReview: "Code and unit tests" },
  { step: "/verify", youReview: "E2E code and failure reports" },
  { step: "/release", youReview: "Version bump and changelog" },
];
---

<section class="container">
  <header>
    <h2>Human checkpoints</h2>
    <span> You approve the specs, plans, code, and tests. <BlinkCursor /></span>
  </header>
  <div class="skills-table-wrap">
    <table class="skills-table">
      <thead>
        <tr>
          <th scope="col">Step</th>
          <th scope="col">You review</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) => (
            <tr>
              <th scope="row">
                <code class="skill-name">{row.step}</code>
              </th>
              <td>{row.youReview}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .skills-table-wrap {
    overflow-x: auto;
    margin: 0;
    padding: 0;
    background: transparent !important;
    border: none;
    backdrop-filter: none;
  }

  .skills-table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.92em;
  }

  .skills-table th,
  .skills-table td {
    padding: 0.65rem 0.85rem;
    vertical-align: top;
    border-bottom: 1px solid var(--ab-glass-border);
  }

  .skills-table thead th {
    font-family: var(--pico-font-family-sans-serif);
    font-weight: 500;
    font-size: 0.85em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ab-comment-color);
    border-bottom-width: 2px;
  }

  .skills-table tbody th[scope="row"] {
    font-weight: 400;
    white-space: nowrap;
  }

  .skill-name {
    font-family: var(--pico-font-family-monospace);
    font-size: 0.95em;
    color: var(--pico-primary);
    background: color-mix(in srgb, var(--pico-primary) 10%, transparent);
    padding: 0.15em 0.45em;
    border-radius: 0.25rem;
  }
</style>
