---
import BlinkCursor from "@components/BlinkCursor.astro";
import MatrixText from "@components/MatrixText.astro";
import type { Cta } from "./Section.types";

export type HeroProps = {
  title: string;
  subtitle: string;
  cta?: Cta;
  secondaryCta?: Cta;
};
const { hero } = Astro.props as { hero: HeroProps };
const { title, subtitle, cta, secondaryCta } = hero;
---

<section id="hero" class="container">
  <header class="">
    <h1 class="color"><MatrixText text={title} /></h1>
  </header>
  <main class="">
    <span>{subtitle}</span>
  </main>
  {
    (cta || secondaryCta) && (
      <footer class="hero-ctas">
        {cta?.link && (
          <a role="button" href={cta.link}>
            {cta.text}
          </a>
        )}
        {cta && !cta.link && (
          <h2 class="primary">
            <span>
              {cta.text}
              <BlinkCursor />
            </span>
          </h2>
        )}
        {secondaryCta?.link && (
          <a role="button" class="outline" href={secondaryCta.link} rel="noopener">
            {secondaryCta.text}
          </a>
        )}
      </footer>
    )
  }
</section>

<style>
  #hero > main {
    margin-left: 0;
    padding-left: 0;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
</style>
